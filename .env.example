# Copy values you want to override into your shell or a local .env file.
# This app has no API keys. Do not put secrets here.
# ASP.NET Core reads these names directly. A .env file is not loaded unless you export it.
# SQLite is the default. Set Database__Provider to MySql only when you have a local server.
# The MySQL password below is a local example, the same one docker compose uses. It is not a production secret.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
Database__Provider=Sqlite
Database__ServerVersion=
ConnectionStrings__Default=Data Source=data/ulric.db
ConnectionStrings__MySql=Server=127.0.0.1;Port=3306;Database=ulric;User=ulric;Password=ulric;CharSet=utf8mb4;
PublicBaseUrl=
PathBase=
Storage__Root=data
Seed__Enabled=true
Ffmpeg__Path=
Ffmpeg__ProbePath=
PublicBaseUrl=
Cors__Origins__0=http://localhost:4200
