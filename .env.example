# Copy values you want to override into your shell or a local .env file.
# This app has no API keys. Do not put secrets here.
# ASP.NET Core reads these names directly. A .env file is not loaded unless you export it.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
ConnectionStrings__Default=Data Source=data/ulric.db
Storage__Root=data
Seed__Enabled=true
Ffmpeg__Path=
Ffmpeg__ProbePath=
PublicBaseUrl=
Cors__Origins__0=http://localhost:4200
